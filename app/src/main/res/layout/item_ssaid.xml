<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_ssaid_item"
    android:elevation="1dp"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/ssaidAppLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/on_surface"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/ssaidPackageName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="middle"
        android:fontFamily="monospace"
        android:maxLines="1"
        android:textColor="@color/on_surface_variant"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/ssaidEntryValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="monospace"
        android:textColor="@color/on_surface"
        android:textIsSelectable="true"
        android:textSize="17sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        tools:ignore="ButtonStyle">

        <Button
            android:id="@+id/editSsaidButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:backgroundTint="@color/button_surface"
            android:minHeight="44dp"
            android:minWidth="0dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="@string/edit_ssaid"
            android:textAllCaps="false"
            android:textColor="@color/on_button_surface"
            android:textSize="13sp" />

        <Button
            android:id="@+id/randomSsaidButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:backgroundTint="@color/button_surface"
            android:minHeight="44dp"
            android:minWidth="0dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="@string/random_ssaid"
            android:textAllCaps="false"
            android:textColor="@color/on_button_surface"
            android:textSize="13sp" />

        <Button
            android:id="@+id/historySsaidButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/button_surface"
            android:minHeight="44dp"
            android:minWidth="0dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="@string/history"
            android:textAllCaps="false"
            android:textColor="@color/on_button_surface"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
